generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         String    @default("admin") @db.VarChar(50)
  lastLogin    DateTime? @map("last_login")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}

model Service {
  serviceId    Int       @id @default(autoincrement()) @map("service_id")
  serviceName  String    @map("service_name") @db.VarChar(100)
  slug         String    @unique @db.VarChar(150)
  description  String    @db.Text
  icon         String    @db.VarChar(255)
  category     String    @db.VarChar(100)
  featured     Boolean   @default(false)
  status       String    @default("active") @db.VarChar(20)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  requests ServiceRequest[]

  @@map("services")
}

model ServiceRequest {
  requestId   Int       @id @default(autoincrement()) @map("request_id")
  serviceId   Int       @map("service_id")
  name        String    @db.VarChar(100)
  email       String    @db.VarChar(120)
  phone       String    @db.VarChar(20)
  company     String?   @db.VarChar(150)
  budget      String?   @db.VarChar(50)
  message     String    @db.Text
  attachment  String?   @db.VarChar(255)
  status      String    @default("Pending") @db.VarChar(30)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  submittedAt DateTime  @default(now()) @map("submitted_at")

  service Service @relation(fields: [serviceId], references: [serviceId])

  @@map("service_requests")
}

model InternshipRole {
  roleId      Int       @id @default(autoincrement()) @map("role_id")
  roleName    String    @map("role_name") @db.VarChar(100)
  department  String    @db.VarChar(100)
  duration    String    @db.VarChar(50)
  openings    Int
  description String    @db.Text
  status      String    @default("open") @db.VarChar(20)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")

  applications InternshipApplication[]

  @@map("internship_roles")
}

model InternshipApplication {
  applicationId     Int       @id @default(autoincrement()) @map("application_id")
  roleId            Int       @map("role_id")
  fullName          String    @map("full_name") @db.VarChar(100)
  email             String    @db.VarChar(120)
  phone             String    @db.VarChar(20)
  college           String    @db.VarChar(150)
  degree            String    @db.VarChar(100)
  yearOfStudy       String    @map("year_of_study") @db.VarChar(20)
  portfolioUrl      String?   @map("portfolio_url") @db.VarChar(255)
  resume            String    @db.VarChar(255)
  coverLetter       String?   @map("cover_letter") @db.Text
  linkedin          String?   @db.VarChar(255)
  github            String?   @db.VarChar(255)
  applicationStatus String    @default("pending") @map("application_status") @db.VarChar(30)
  isDeleted         Boolean   @default(false) @map("is_deleted")
  deletedAt         DateTime? @map("deleted_at")
  appliedAt         DateTime  @default(now()) @map("applied_at")

  role InternshipRole @relation(fields: [roleId], references: [roleId])

  @@map("internship_applications")
}

model Testimonial {
  testimonialId Int       @id @default(autoincrement()) @map("testimonial_id")
  clientName    String    @map("client_name") @db.VarChar(100)
  email         String?   @db.VarChar(120)
  phone         String?   @db.VarChar(20)
  company       String?   @db.VarChar(150)
  designation   String?   @db.VarChar(100)
  profilePhoto  String?   @map("profile_photo") @db.VarChar(255)
  review        String    @db.Text
  rating        Int
  featured      Boolean   @default(false)
  approved      Boolean   @default(false)
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("testimonials")
}

model Contact {
  contactId   Int       @id @default(autoincrement()) @map("contact_id")
  name        String    @db.VarChar(100)
  email       String    @db.VarChar(120)
  phone       String?   @db.VarChar(20)
  subject     String    @db.VarChar(150)
  message     String    @db.Text
  enquiryType String    @map("enquiry_type") @db.VarChar(50)
  status      String    @default("pending") @db.VarChar(30)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("contacts")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  adminId   Int?     @map("admin_id")
  action    String   @db.VarChar(255)
  entity    String   @db.VarChar(100)
  entityId  Int?     @map("entity_id")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  browser   String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}

model Setting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
